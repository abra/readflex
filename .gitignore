# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
.gitkeep

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/node_modules/
build/
coverage/
# Independent library test environments; the application lockfile is tracked.
/packages/**/pubspec.lock
/third_party/**/pubspec.lock
lib/src/l10n/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

.claude
.agents/
.jj
.docs
.local/
.tmp/
CLAUDE.md
AGENT.md
AGENTS.md

# Local/private tooling experiments and generated outputs.
tool/
tools/

# FVM Version Cache
.fvm/

# Private environment and signing files, wherever local tooling creates them.
.env
.env.*
!.env.example
*.jks
*.keystore
key.properties

# Keep shared configuration even when a developer's global ignore is broader.
!/.gitignore
!/android/.gitignore
!/ios/.gitignore
!/.fvmrc
!/pubspec.lock
!/ios/Podfile.lock
