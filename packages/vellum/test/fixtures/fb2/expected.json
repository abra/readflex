   {
    "size": 454,
    "linear": null,
    "body": "<img xmlns=\"http://www.w3.org/1999/xhtml\" src=\"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAP//////////////////////////////////////////////////////////////////////////////////////wgALCAABAAEBAREA/8QAFBABAAAAAAAAAAAAAAAAAAAAAP/aAAgBAQABPxA=\" />"
   },
   {
    "size": 391,
    "linear": null,
    "body": "<section xmlns=\"http://www.w3.org/1999/xhtml\" class=\"title\"><h1 class=\"p\">Часть первая</h1><br class=\"empty-line\" /><h1 class=\"p\">Подзаголовок части</h1></section>"
   },
   {
    "size": 355,
    "linear": null,
    "body": "<section xmlns=\"http://www.w3.org/1999/xhtml\" class=\"epigraph\"><p class=\"p\">Эпиграф книги.</p><p class=\"text-author\">Кто-то</p></section>"
   },
   {
    "size": 2413,
    "linear": null,
    "body": "<section xmlns=\"http://www.w3.org/1999/xhtml\" id=\"ch1\" class=\"section\">\n    <header class=\"title\"><h1 class=\"p\">Глава 1</h1></header>\n    <blockquote class=\"epigraph\"><p class=\"p\">Эпиграф главы</p></blockquote>\n    <p class=\"p\">Первый абзац с <em class=\"emphasis\">курсивом</em>, <strong class=\"strong\">жирным</strong>, <s class=\"strikethrough\">зачёркнутым</s>, x<sub class=\"sub\">2</sub> и x<sup class=\"sup\">2</sup>, <code class=\"code\">кодом</code> и <span class=\"style\">стилем</span>.</p>\n    <p class=\"p\">Сноска<a xmlns:epub=\"http://www.idpf.org/2007/ops\" class=\"a\" href=\"#n1\" epub:type=\"noteref\">[1]</a> и внешняя <a class=\"a\" href=\"https://example.com\">ссылка</a>, внутренняя <a class=\"a\" href=\"#ch2\">ссылка</a>.</p>\n    <br class=\"empty-line\" />\n    <h2 class=\"subtitle\">Подзаголовок</h2>\n    <blockquote class=\"cite\"><p class=\"p\">Цитата.</p><p class=\"text-author\">Автор цитаты</p></blockquote>\n    <blockquote class=\"poem\">\n      \n      <blockquote class=\"epigraph\"><p class=\"p\">Эпиграф стиха</p></blockquote>\n      <p class=\"stanza\">\n        <header class=\"title\"><strong class=\"p\">Строфа</strong></header>\n        <p class=\"subtitle\">Подзаголовок строфы</p>\n        \n        \n      Первая строка<br />Вторая строка<br /></p>\n      <p class=\"text-author\">Поэт</p>\n      <p class=\"date\">1890</p>\n    </blockquote>\n    <table class=\"table\"><tr class=\"tr\" align=\"center\"><th class=\"th\" colspan=\"2\" valign=\"top\">Заголовок</th></tr><tr class=\"tr\"><td class=\"td\" align=\"right\">a</td><td class=\"td\" rowspan=\"2\">b</td></tr></table>\n    <img src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVQI12P4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC\" />\n    <img src=\"#missing.png\" />\n    <img src=\"external.png\" />\n    <img src=\"data:,\" />\n    <section id=\"ch1-1\" class=\"section\">\n      <header class=\"title\" data-foliate-id=\"0\"><h1 class=\"p\">Глава 1.1</h1></header>\n      <p class=\"p\">Вложенная.</p>\n      \n    </section>\n    <section class=\"section\">\n      <header class=\"title\" data-foliate-id=\"1\"><h1 class=\"p\">Глава 1.2</h1></header>\n      <p class=\"p\">Ещё.</p>\n    </section>\n    <aside class=\"annotation\"></aside>\n  </section>"
   },
   {
    "size": 529,
    "linear": null,
    "body": "<section xmlns=\"http://www.w3.org/1999/xhtml\" id=\"ch2\" class=\"section\">\n    <p class=\"p\">Глава без заголовка начинается с абзаца.</p>\n    <section class=\"section\"><header class=\"title\" data-foliate-id=\"0\"><h1 class=\"p\">Внутренняя</h1></header><p class=\"p\">x</p></section>\n  </section>"
